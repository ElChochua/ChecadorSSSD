<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChecadorSSSD.Views.PersonasView"
             x:DataType="vm:PersonasViewModel"
             xmlns:vm="clr-namespace:ChecadorSSSD.ViewModels"
             xmlns:models="clr-namespace:ChecadorSSSD.Models"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushSuperficieInteractiva}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*"
          Background="{StaticResource BrushFondo}">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,360"
              Margin="0,0,0,22">
            <StackPanel Spacing="4">
                <TextBlock Text="Personas"
                           Classes="page-title" />
                <TextBlock Text="Consulta los usuarios registrados y abre su expediente."
                           FontSize="13"
                           Classes="muted" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="7">
                <TextBlock Text="Buscar"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Classes="muted" />
                <Grid>
                    <TextBox Text="{Binding Busqueda}"
                             PlaceholderText="Nombre o matrícula"
                             Padding="40,8,12,8" />
                    <Image Source="avares://ChecadorSSSD/Assets/Icons/search.png"
                           Width="17"
                           Height="17"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="13,0,0,0"
                           IsHitTestVisible="False" />
                </Grid>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              IsVisible="{Binding MostrarMensaje}"
              Margin="0,0,0,16">
            <Border Background="{StaticResource BrushExitoSuave}"
                    BorderBrush="{StaticResource BrushVerdeExito}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12"
                    IsVisible="{Binding EsError, Converter={StaticResource InverseBoolConverter}}">
                <TextBlock Text="{Binding Mensaje}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource BrushTextoPrincipal}" />
            </Border>
            <Border Background="{StaticResource BrushErrorSuave}"
                    BorderBrush="{StaticResource BrushRojoError}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12"
                    IsVisible="{Binding EsError}">
                <TextBlock Text="{Binding Mensaje}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource BrushTextoPrincipal}" />
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Classes="surface"
                Padding="0"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,*,Auto">
                <Border Grid.Row="0"
                        Background="{StaticResource BrushSuperficieElevada}"
                        BorderBrush="{StaticResource BrushBorde}"
                        BorderThickness="0,0,0,1"
                        Padding="18,13">
                    <Grid ColumnDefinitions="2*,*,*,112">
                        <Button Grid.Column="0"
                                Content="Nombre completo"
                                Foreground="{StaticResource BrushTextoSecundario}"
                                FontSize="12"
                                Padding="4"
                                MinHeight="28"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                Command="{Binding OrdenarHeaderCommand}"
                                CommandParameter="Nombre" />
                        <Button Grid.Column="1"
                                Content="Matrícula"
                                Foreground="{StaticResource BrushTextoSecundario}"
                                FontSize="12"
                                Padding="4"
                                MinHeight="28"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                Command="{Binding OrdenarHeaderCommand}"
                                CommandParameter="Matricula" />
                        <Button Grid.Column="2"
                                Content="Rol"
                                Foreground="{StaticResource BrushTextoSecundario}"
                                FontSize="12"
                                Padding="4"
                                MinHeight="28"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                Command="{Binding OrdenarHeaderCommand}"
                                CommandParameter="Rol" />
                        <TextBlock Grid.Column="3"
                                   Text="Acciones"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Classes="muted"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Personas}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:Personas">
                            <Border Background="Transparent"
                                    BorderBrush="{StaticResource BrushBorde}"
                                    BorderThickness="0,0,0,1"
                                    Padding="18,13">
                                <Grid ColumnDefinitions="2*,*,*,112">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding NombreCompleto}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Matricula}"
                                               Foreground="{StaticResource BrushAcento}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="2"
                                            Background="{StaticResource BrushAcentoSuave}"
                                            BorderBrush="{StaticResource BrushBorde}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="9,4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TipoPersona}"
                                                   Foreground="{StaticResource BrushDoradoTenue}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                HorizontalAlignment="Right">
                                        <Button Classes="secondary"
                                                Command="{Binding $parent[ItemsControl].DataContext.VerCommand}"
                                                CommandParameter="{Binding}"
                                                Height="34"
                                                Width="42"
                                                MinHeight="34"
                                                Padding="0"
                                                ToolTip.Tip="Ver expediente">
                                            <Image Source="avares://ChecadorSSSD/Assets/Icons/user.png"
                                                   Width="16"
                                                   Height="16" />
                                        </Button>
                                        <Button Classes="secondary"
                                                Command="{Binding $parent[ItemsControl].DataContext.CopiarMatriculaCommand}"
                                                CommandParameter="{Binding}"
                                                Height="34"
                                                Width="42"
                                                MinHeight="34"
                                                Padding="0"
                                                ToolTip.Tip="Copiar matrícula">
                                            <Image Source="avares://ChecadorSSSD/Assets/Icons/copy.png"
                                                   Width="16"
                                                   Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2"
                        Background="{StaticResource BrushSuperficieElevada}"
                        BorderBrush="{StaticResource BrushBorde}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <Grid ColumnDefinitions="*,Auto,*">
                        <Button Grid.Column="0"
                                Classes="secondary"
                                Content="Anterior"
                                Command="{Binding PaginaAnteriorCommand}"
                                MinHeight="34"
                                Height="34"
                                Padding="14,4"
                                HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding RangoPaginaText}"
                                   FontSize="12"
                                   Classes="muted"
                                   Margin="18,0"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Classes="secondary"
                                Content="Siguiente"
                                Command="{Binding PaginaSiguienteCommand}"
                                MinHeight="34"
                                Height="34"
                                Padding="14,4"
                                HorizontalAlignment="Left" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
