<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChecadorSSSD.Views.ChecadorView"
             x:DataType="vm:ChecadorViewModel"
             xmlns:vm="clr-namespace:ChecadorSSSD.ViewModels"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Grid RowDefinitions="Auto,*"
          Background="{StaticResource BrushFondo}">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,0,0,22">
            <StackPanel Spacing="4">
                <TextBlock Text="Registro de asistencia"
                           Classes="page-title" />
                <TextBlock Text="Marca tu entrada o salida con huella o matrícula."
                           FontSize="13"
                           Classes="muted" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                <Border Width="72"
                        Height="46"
                        Classes="surface"
                        Padding="6"
                        IsVisible="{Binding HasLogoPrograma}"
                        ToolTip.Tip="Logo del módulo">
                    <Image Source="{Binding LogoPrograma}"
                           Stretch="Uniform" />
                </Border>
                <Border Width="72"
                        Height="46"
                        Classes="surface"
                        Padding="6"
                        IsVisible="{Binding HasImagenUniversidad}"
                        ToolTip.Tip="Logo institucional">
                    <Image Source="{Binding ImagenUniversidad}"
                           Stretch="Uniform" />
                </Border>
                <Border Width="72"
                        Height="46"
                        Classes="surface"
                        Padding="6"
                        IsVisible="{Binding HasImagenLugar}"
                        ToolTip.Tip="Logo del lugar">
                    <Image Source="{Binding ImagenLugar}"
                           Stretch="Uniform" />
                </Border>
            </StackPanel>

            <Border Grid.Column="2"
                    Background="{StaticResource BrushExitoSuave}"
                    BorderBrush="{StaticResource BrushVerdeExito}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    VerticalAlignment="Center"
                    IsVisible="{Binding LectorHuellaConectado}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource FingerprintIconGeometry}"
                              Width="17"
                              Height="17"
                              Foreground="{StaticResource BrushAcento}" />
                    <TextBlock Text="Lector conectado"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushVerdeExito}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Background="{StaticResource BrushErrorSuave}"
                    BorderBrush="{StaticResource BrushRojoError}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !LectorHuellaConectado}">
                <TextBlock Text="Lector no disponible"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushRojoError}" />
            </Border>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="6*,5*"
              ColumnSpacing="22">
            <Border Grid.Column="0"
                    Classes="surface"
                    Padding="34">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock Text="HORA LOCAL"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.4"
                                   Classes="muted" />
                        <TextBlock Text="{Binding HoraActual}"
                                   FontSize="92"
                                   FontWeight="SemiBold"
                                   LetterSpacing="-2"
                                   Foreground="{StaticResource BrushTextoPrincipal}"
                                   FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter" />
                        <TextBlock Text="{Binding FechaActual}"
                                   FontSize="17"
                                   Foreground="{StaticResource BrushAcento}"
                                   Margin="2,2,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1"
                          VerticalAlignment="Center"
                          Margin="0,30">
                        <StackPanel Spacing="20"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding !MostrarFotoPersona}">
                            <Border Width="116"
                                    Height="116"
                                    CornerRadius="58"
                                    Background="{StaticResource BrushAcentoSuave}"
                                    BorderBrush="{StaticResource BrushAcento}"
                                    BorderThickness="1">
                                <PathIcon Data="{StaticResource FingerprintIconGeometry}"
                                          Width="58"
                                          Height="58"
                                          Foreground="{StaticResource BrushAcento}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Coloca tu dedo en el lector"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Mantén el dedo firme hasta recibir la confirmación."
                                           FontSize="13"
                                           Classes="muted"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <Border Classes="surface-raised"
                                Padding="12"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding MostrarFotoPersona}">
                            <Image Source="{Binding ImagenPersona}"
                                   Width="300"
                                   Height="300"
                                   Stretch="UniformToFill" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Background="{StaticResource BrushFondo}"
                            BorderBrush="{StaticResource BrushBorde}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,11">
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon Data="{StaticResource FingerprintIconGeometry}"
                                      Width="18"
                                      Height="18"
                                      Foreground="{StaticResource BrushAcento}"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding EstadoLector}"
                                       FontSize="12"
                                       Classes="muted"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1"
                  RowDefinitions="*">
                <Border Grid.Row="0"
                        Classes="surface-raised"
                        Padding="34"
                        VerticalAlignment="Stretch">
                    <StackPanel Spacing="20"
                                VerticalAlignment="Center">
                        <Grid IsVisible="{Binding MostrarMensaje}"
                              Margin="0,0,0,2">
                            <Border Background="{StaticResource BrushExitoSuave}"
                                    BorderBrush="{StaticResource BrushVerdeExito}"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Padding="18,16"
                                    IsVisible="{Binding EsError, Converter={StaticResource InverseBoolConverter}}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="REGISTRO CONFIRMADO"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               LetterSpacing="1.2"
                                               Foreground="{StaticResource BrushVerdeExito}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Mensaje}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Foreground="{StaticResource BrushTextoPrincipal}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BrushErrorSuave}"
                                    BorderBrush="{StaticResource BrushRojoError}"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Padding="18,16"
                                    IsVisible="{Binding EsError}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="ATENCIÓN"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               LetterSpacing="1.2"
                                               Foreground="{StaticResource BrushRojoError}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Mensaje}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Foreground="{StaticResource BrushTextoPrincipal}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Registro por matrícula"
                                       Classes="section-title" />
                            <TextBlock Text="Úsalo cuando no puedas registrar tu huella."
                                       FontSize="13"
                                       Classes="muted" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Matrícula"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextoSecundario}" />
                            <TextBox x:Name="MatriculaTextBox"
                                     Text="{Binding Matricula}"
                                     KeyDown="OnMatriculaKeyDown"
                                     PlaceholderText="Escribe tu matrícula"
                                     Height="58"
                                     FontSize="21"
                                     LetterSpacing="0.6"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>

                        <Button Classes="primary"
                                Content="Registrar asistencia"
                                Command="{Binding RegistrarCommand}"
                                Height="54"
                                FontSize="16"
                                HorizontalAlignment="Stretch" />

                        <Button Classes="secondary"
                                Command="{Binding ReconectarLectorCommand}"
                                Content="Reintentar conexión"
                                HorizontalAlignment="Stretch"
                                IsVisible="{Binding !LectorHuellaConectado}" />

                        <Border Background="{StaticResource BrushFondo}"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,4,0,0">
                            <TextBlock Text="Cada registro alterna automáticamente entre entrada y salida."
                                       FontSize="12"
                                       Classes="muted"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
