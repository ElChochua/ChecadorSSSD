<Window xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:local="clr-namespace:ChecadorSSSD.Views"
         mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="440"
         x:Class="ChecadorSSSD.Views.FingerprintEnrollmentDialog"
         Title="Captura de Huella - Enrollment"
         Width="520" Height="440"
         WindowStartupLocation="CenterOwner"
         CanResize="False">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,15">
            <TextBlock x:Name="TitleText"
                       Text="Registro de Huella Dactilar"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource BrushDoradoUniversidad}"
                       TextAlignment="Center"/>
            <TextBlock x:Name="StatusText"
                       Text="Coloque su dedo en el lector (Captura 1/4)"
                       FontSize="14"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BrushBlanco}"/>
        </StackPanel>

        <!-- Main content: fingerprint image + progress -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,5">
            <!-- Left: fingerprint image preview -->
            <Border Grid.Column="0"
                    Background="{StaticResource BrushAzulFondoCont}"
                    BorderBrush="{StaticResource BrushCappuccino}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,10,0"
                    MinHeight="200">
                <Grid>
                    <Image x:Name="FingerprintImage"
                           Stretch="Uniform"
                           Margin="20"
                           IsVisible="False"/>
                    <StackPanel x:Name="NoImagePlaceholder"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="10">
                        <PathIcon Data="M12,2C14.09,2 16.09,2.67 17.72,3.84L16.29,5.27C15.11,4.46 13.61,4 12,4A5,5 0 0,0 7,9V14.17L5.71,15.46L5,14.76L5,9A7,7 0 0,1 12,2M12,6A3,3 0 0,1 15,9V11.17L12.83,9A3,3 0 0,0 12,7C10.21,7 9,8.21 9,10V14.76L7,16.76V10A5,5 0 0,1 12,5M17.62,14.3L19.05,12.88L12,5.83L4.95,12.88L6.38,14.3L12,8.68L17.62,14.3Z"
                                  Width="80" Height="80"
                                  Foreground="{StaticResource BrushGrisTextoClaro}"/>
                        <TextBlock Text="Coloque su dedo en el lector"
                                   Foreground="{StaticResource BrushGrisTextoClaro}"
                                   FontSize="12" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: progress indicators -->
            <StackPanel Grid.Column="1" Spacing="12" MinWidth="130">
                <TextBlock Text="Progreso:" FontWeight="Bold"
                           Foreground="{StaticResource BrushDoradoUniversidad}"/>

                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*">
                        <Ellipse x:Name="Step1Dot" Width="22" Height="22" Grid.Column="0"
                                 Fill="Gray" Margin="0,0,8,0"/>
                        <TextBlock Text="Captura 1" Grid.Column="1" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushBlanco}"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <Ellipse x:Name="Step2Dot" Width="22" Height="22" Grid.Column="0"
                                 Fill="Gray" Margin="0,0,8,0"/>
                        <TextBlock Text="Captura 2" Grid.Column="1" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushBlanco}"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <Ellipse x:Name="Step3Dot" Width="22" Height="22" Grid.Column="0"
                                 Fill="Gray" Margin="0,0,8,0"/>
                        <TextBlock Text="Captura 3" Grid.Column="1" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushBlanco}"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <Ellipse x:Name="Step4Dot" Width="22" Height="22" Grid.Column="0"
                                 Fill="Gray" Margin="0,0,8,0"/>
                        <TextBlock Text="Captura 4" Grid.Column="1" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushBlanco}"/>
                    </Grid>
                </StackPanel>

                <!-- Capturing indicator -->
                <Border x:Name="CapturingPanel"
                        Background="{StaticResource BrushAzulMarinoMedio}"
                        CornerRadius="4" Padding="10" IsVisible="False">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Leyendo..." Foreground="{StaticResource BrushDoradoUniversidad}"
                                   FontWeight="Bold" TextAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True"
                                     Foreground="{StaticResource BrushDoradoUniversidad}"
                                     Background="{StaticResource BrushAzulMarino}"/>
                    </StackPanel>
                </Border>

                <!-- Success -->
                <Border x:Name="SuccessPanel"
                        Background="{StaticResource BrushVerdeExito}"
                        CornerRadius="4" Padding="10" IsVisible="False">
                    <TextBlock Text="Huella registrada" Foreground="{StaticResource BrushBlanco}"
                               FontWeight="Bold" TextAlignment="Center"/>
                </Border>

                <!-- Error -->
                <Border x:Name="ErrorPanel"
                        Background="{StaticResource BrushRojoError}"
                        CornerRadius="4" Padding="10" IsVisible="False">
                    <TextBlock Text="Error en captura" Foreground="{StaticResource BrushBlanco}"
                               FontWeight="Bold" TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                    Spacing="15" Margin="0,20,0,0">
            <Button x:Name="CancelBtn" Content="Cancelar" Click="CancelBtn_Click"
                    Width="120" Classes="secondary"/>
            <Button x:Name="AcceptBtn" Content="Aceptar" Click="AcceptBtn_Click"
                    Width="120" Classes="primary" IsVisible="False"/>
            <Button x:Name="RetryBtn" Content="Reintentar" Click="RetryBtn_Click"
                    Width="120" Classes="secondary" IsVisible="False"/>
        </StackPanel>
    </Grid>
</Window>