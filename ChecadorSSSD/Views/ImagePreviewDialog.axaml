<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ChecadorSSSD.Views.ImagePreviewDialog"
        Title="Vista previa"
        Background="#000000"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Width="800" Height="600">
    <Grid>
        <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" />
        <Button Content="X" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Background="Transparent" Foreground="White" FontSize="18" Click="CloseButton_Click" />
    </Grid>
</Window>
