<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChecadorSSSD.App"
             xmlns:converters="clr-namespace:ChecadorSSSD.Converters"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />

        <!-- Sistema visual: superficies frías, acento institucional y radios consistentes. -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoPrincipal}" />
        </Style>
        <Style Selector="UserControl">
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoPrincipal}" />
        </Style>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoPrincipal}" />
            <Setter Property="LetterSpacing" Value="-0.4" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoPrincipal}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoSecundario}" />
        </Style>
        <Style Selector="Border.surface">
            <Setter Property="Background" Value="{DynamicResource BrushSuperficie}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorde}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Border.surface-raised">
            <Setter Property="Background" Value="{DynamicResource BrushSuperficieElevada}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorde}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="0 12 32 0 #26000000" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource BrushAcento}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoSobreAcento}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushAcentoHover}" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource BrushSuperficieElevada}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoPrincipal}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBordeFuerte}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSuperficieInteractiva}" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoSecundario}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="46" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSuperficieInteractiva}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoPrincipal}" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource BrushAcentoSuave}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAcento}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Background" Value="{DynamicResource BrushFondo}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoPrincipal}" />
            <Setter Property="CaretBrush" Value="{DynamicResource BrushAcento}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBordeFuerte}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAcento}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Background" Value="{DynamicResource BrushFondo}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoPrincipal}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBordeFuerte}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="DatePicker">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Background" Value="{DynamicResource BrushFondo}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoPrincipal}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBordeFuerte}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource BrushSuperficieElevada}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoPrincipal}" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <!-- Material Icons "fingerprint", Apache-2.0. Vectorial para cualquier escala. -->
        <StreamGeometry x:Key="FingerprintIconGeometry">M17.81 4.47c-.08 0-.16-.02-.23-.06C15.66 3.42 14 3 12.01 3c-1.98 0-3.86.47-5.57 1.41-.24.13-.54.04-.68-.2-.13-.24-.04-.55.2-.68C7.82 2.52 9.86 2 12.01 2c2.13 0 3.99.47 6.03 1.52.25.13.34.43.21.67-.09.18-.26.28-.44.28zM3.5 9.72c-.1 0-.2-.03-.29-.09-.23-.16-.28-.47-.12-.7.99-1.4 2.25-2.5 3.75-3.27C9.98 4.04 14 4.03 17.15 5.65c1.5.77 2.76 1.86 3.75 3.25.16.22.11.54-.12.7-.23.16-.54.11-.7-.12-.9-1.26-2.04-2.25-3.39-2.94-2.87-1.47-6.54-1.47-9.4.01-1.36.7-2.5 1.7-3.4 2.96-.08.14-.23.21-.39.21zm6.25 12.07c-.13 0-.26-.05-.35-.15-.87-.87-1.34-1.43-2.01-2.64-.69-1.23-1.05-2.73-1.05-4.34 0-2.97 2.54-5.39 5.66-5.39s5.66 2.42 5.66 5.39c0 .28-.22.5-.5.5s-.5-.22-.5-.5c0-2.42-2.09-4.39-4.66-4.39s-4.66 1.97-4.66 4.39c0 1.44.32 2.77.93 3.85.64 1.15 1.08 1.64 1.85 2.42.19.2.19.51 0 .71-.11.1-.24.15-.37.15zm7.17-1.85c-1.19 0-2.24-.3-3.1-.89-1.49-1.01-2.38-2.65-2.38-4.39 0-.28.22-.5.5-.5s.5.22.5.5c0 1.41.72 2.74 1.94 3.56.71.48 1.54.71 2.54.71.24 0 .64-.03 1.04-.1.27-.05.53.13.58.41.05.27-.13.53-.41.58-.57.11-1.07.12-1.21.12zM14.91 22c-.04 0-.09-.01-.13-.02-1.59-.44-2.63-1.03-3.72-2.1-1.4-1.39-2.17-3.24-2.17-5.22 0-1.62 1.38-2.94 3.08-2.94s3.08 1.32 3.08 2.94c0 1.07.93 1.94 2.08 1.94s2.08-.87 2.08-1.94c0-3.77-3.25-6.83-7.25-6.83-2.84 0-5.44 1.58-6.61 4.03-.39.81-.59 1.76-.59 2.8 0 .78.07 2.01.67 3.61.1.26-.03.55-.29.64-.26.1-.55-.04-.64-.29-.49-1.31-.73-2.61-.73-3.96 0-1.2.23-2.29.68-3.24 1.33-2.79 4.28-4.6 7.51-4.6 4.55 0 8.25 3.51 8.25 7.83 0 1.62-1.38 2.94-3.08 2.94s-3.08-1.32-3.08-2.94c0-1.07-.93-1.94-2.08-1.94s-2.08.87-2.08 1.94c0 1.71.66 3.31 1.87 4.51.95.94 1.86 1.46 3.27 1.85.27.07.42.35.35.61-.05.23-.26.38-.47.38z</StreamGeometry>

        <!-- Tokens semánticos -->
        <Color x:Key="Fondo">#08111F</Color>
        <Color x:Key="FondoProfundo">#060D18</Color>
        <Color x:Key="Superficie">#101C2D</Color>
        <Color x:Key="SuperficieElevada">#162438</Color>
        <Color x:Key="SuperficieInteractiva">#1D2E45</Color>
        <Color x:Key="Borde">#23354C</Color>
        <Color x:Key="BordeFuerte">#344A64</Color>
        <Color x:Key="TextoPrincipal">#F2F5F9</Color>
        <Color x:Key="TextoSecundario">#A5B2C2</Color>
        <Color x:Key="Acento">#E7B95F</Color>
        <Color x:Key="AcentoHover">#F0C875</Color>
        <Color x:Key="AcentoSuave">#2F2A20</Color>
        <Color x:Key="TextoSobreAcento">#15110A</Color>
        <Color x:Key="Exito">#42A77A</Color>
        <Color x:Key="ExitoSuave">#173B31</Color>
        <Color x:Key="Error">#D36262</Color>
        <Color x:Key="ErrorSuave">#442426</Color>

        <SolidColorBrush x:Key="BrushFondo" Color="{StaticResource Fondo}" />
        <SolidColorBrush x:Key="BrushFondoProfundo" Color="{StaticResource FondoProfundo}" />
        <SolidColorBrush x:Key="BrushSuperficie" Color="{StaticResource Superficie}" />
        <SolidColorBrush x:Key="BrushSuperficieElevada" Color="{StaticResource SuperficieElevada}" />
        <SolidColorBrush x:Key="BrushSuperficieInteractiva" Color="{StaticResource SuperficieInteractiva}" />
        <SolidColorBrush x:Key="BrushBorde" Color="{StaticResource Borde}" />
        <SolidColorBrush x:Key="BrushBordeFuerte" Color="{StaticResource BordeFuerte}" />
        <SolidColorBrush x:Key="BrushTextoPrincipal" Color="{StaticResource TextoPrincipal}" />
        <SolidColorBrush x:Key="BrushTextoSecundario" Color="{StaticResource TextoSecundario}" />
        <SolidColorBrush x:Key="BrushAcento" Color="{StaticResource Acento}" />
        <SolidColorBrush x:Key="BrushAcentoHover" Color="{StaticResource AcentoHover}" />
        <SolidColorBrush x:Key="BrushAcentoSuave" Color="{StaticResource AcentoSuave}" />
        <SolidColorBrush x:Key="BrushTextoSobreAcento" Color="{StaticResource TextoSobreAcento}" />
        <SolidColorBrush x:Key="BrushExitoSuave" Color="{StaticResource ExitoSuave}" />
        <SolidColorBrush x:Key="BrushErrorSuave" Color="{StaticResource ErrorSuave}" />

        <!-- Alias compatibles con las vistas existentes -->
        <Color x:Key="AzulMarino">#08111F</Color>
        <Color x:Key="AzulMarinoMedio">#162438</Color>
        <Color x:Key="AzulMarinoClaro">#1D2E45</Color>
        <Color x:Key="AzulMarinoSidebar">#060D18</Color>
        <Color x:Key="DoradoUniversidad">#E7B95F</Color>
        <Color x:Key="DoradoOscuro">#8C703B</Color>
        <Color x:Key="DoradoTenue">#D9C79F</Color>
        <Color x:Key="GrisTextoClaro">#A5B2C2</Color>
        <Color x:Key="Blanco">#F2F5F9</Color>
        <Color x:Key="Negro">#15110A</Color>
        <Color x:Key="RojoError">#D36262</Color>
        <Color x:Key="VerdeExito">#42A77A</Color>
        <Color x:Key="Cappuccino">#23354C</Color>
        <Color x:Key="AzulFondoCont">#101C2D</Color>

        <SolidColorBrush x:Key="BrushAzulMarino" Color="{StaticResource AzulMarino}" />
        <SolidColorBrush x:Key="BrushAzulMarinoMedio" Color="{StaticResource AzulMarinoMedio}" />
        <SolidColorBrush x:Key="BrushAzulMarinoClaro" Color="{StaticResource AzulMarinoClaro}" />
        <SolidColorBrush x:Key="BrushAzulMarinoSidebar" Color="{StaticResource AzulMarinoSidebar}" />
        <SolidColorBrush x:Key="BrushDoradoUniversidad" Color="{StaticResource DoradoUniversidad}" />
        <SolidColorBrush x:Key="BrushDoradoOscuro" Color="{StaticResource DoradoOscuro}" />
        <SolidColorBrush x:Key="BrushDoradoTenue" Color="{StaticResource DoradoTenue}" />
        <SolidColorBrush x:Key="BrushGrisTextoClaro" Color="{StaticResource GrisTextoClaro}" />
        <SolidColorBrush x:Key="BrushBlanco" Color="{StaticResource Blanco}" />
        <SolidColorBrush x:Key="BrushNegro" Color="{StaticResource Negro}" />
        <SolidColorBrush x:Key="BrushRojoError" Color="{StaticResource RojoError}" />
        <SolidColorBrush x:Key="BrushVerdeExito" Color="{StaticResource VerdeExito}" />
        <SolidColorBrush x:Key="BrushCappuccino" Color="{StaticResource Cappuccino}" />
        <SolidColorBrush x:Key="BrushAzulFondoCont" Color="{StaticResource AzulFondoCont}" />

        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
        <converters:IntToBrushConverter x:Key="IntToBrushConverter" />
        <converters:IndexEqualsConverter x:Key="IndexEqualsConverter" />
    </Application.Resources>
</Application>
